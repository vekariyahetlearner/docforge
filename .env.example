# DocForge Environment Configuration Example
# Copy this file to .env and adjust values for your local setup

# Application Environment
NODE_ENV=development
PORT=3001

# Client URL (CORS allowlist)
FRONTEND_URL=http://localhost:5173

# File Processing Configuration
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# Conversion Engine Configuration
# Path to the LibreOffice binary (default on Debian/Ubuntu systems: /usr/bin/libreoffice)
LIBREOFFICE_PATH=/usr/bin/libreoffice
